{
  "ApiKeys": {
    "OpenAI": "sk-KnFn4kjeqXb7Din_xv_Phw"
  },
  "ApiEndpoint": {
    "Endpoint": "https://litellm.ai.paas.htec.rs"
  },
  "Ingestion": {
    "InputDirectory": "data",
    "VectorStoreDirectory": "vectorstore"
  },
  "Embedding": {
    "ModelId": "l2-text-embedding-3-small",
    "Dimensions": 1536,
    "BatchSize": 100
  },
  "Chunking": {
    "TokenizerModel": "gpt-4"
  },
  "Search": {
    "TopK": 5,
    "IncludeNeighbors": true,
    "NeighborsBefore": 1,
    "NeighborsAfter": 1,
    "MinRelevanceScore": 0.5
  },

  "Model": {
    "ModelId": "l2-gpt-4o",
    "ModelLightId": "l2-gpt-4o-mini",
    "Temperature": 0.7,
    "MaxTokens": 1500,
    "TopP": 0.9,

    "MaxInputTokens": 15000
  },
  "Assistant": {
    "Name": "HAL 9000",
    "PersonalityPromptPath": "Prompts/chatbot_personality.yaml",
    "EnableTools": true,
    "KeepRecentCount": 3,
    "SummarizationThreshold": 0.7
  },
  "Retrieval": {
    "MaxTopK": 10
  },

  "Tools": {
    "DateTools": {
      "Enabled": true
    },
    "RetrievalTool": {
      "Enabled": true
    }
  },

  "Experiments": {
    "OutputDirectory": "results",
    "Configurations": [
      {
        "Name": "baseline",
        "Description": "Baseline configuration with l2-gpt-4o",
        "ModelId": "l2-gpt-4o",
        "Temperature": 0.7,
        "TopP": 0.9,
        "TopK": 2,
        "MinRelevanceScore": 0.5,
        "IncludeNeighbors": true
      },
      {
        "Name": "high_precision",
        "Description": "High precision with stricter relevance",
        "ModelId": "l2-gpt-4o",
        "Temperature": 0.3,
        "TopP": 0.95,
        "TopK": 3,
        "MinRelevanceScore": 0.75,
        "IncludeNeighbors": false
      },
      {
        "Name": "cost_efficient",
        "Description": "Cost-efficient with smaller model",
        "ModelId": "l2-gpt-4o-mini",
        "Temperature": 0.7,
        "TopP": 0.9,
        "TopK": 5,
        "MinRelevanceScore": 0.5,
        "IncludeNeighbors": true
      }
    ]
  },
  "Metrics": {
    "EvaluatorModel": "l2-gpt-4o",
    "EvaluatorTemperature": 0.1,
    "EvaluatorTopP": 0.8
  },
  "Dataset": {
    "GoldenDatasetPath": "goldendataset/golden_dataset.json"
  },
  "EvaluationPromptPaths": {
    "RetrievalMetricsPromptPath": "Prompts/retrieval_metrics.yaml",
    "AnswerQualityPromptPath": "Prompts/answer_quality.yaml"
  }
}
